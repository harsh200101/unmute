# Copy to .env and adjust if needed. .env is gitignored.
VITE_API_URL=http://localhost:5001

# Public Razorpay key id only (safe to expose). NEVER add RAZORPAY_KEY_SECRET
# here — anything VITE_* is baked into the browser bundle.
# Leave empty to hide the Razorpay modal path and use the backend-provided key.
VITE_RAZORPAY_KEY_ID=

# Cosmetic label for the top-up modal; the backend PAYMENT_GATEWAY decides the
# real flow. One of: razorpay | phonepe.
VITE_PAYMENT_GATEWAY=phonepe

# Repo-root .env.example - LEGACY, superseded.
#
# This file is kept only so an existing root .env does not confuse anyone.
# The backend does NOT read a root .env: it loads backend/.env
# (require('dotenv').config() resolves relative to the process cwd, which is
# the backend directory in every npm script and on Render).
#
# Every variable below is either unused or wrong:
#   PHONEPE_BASE_URL, PHONEPE_CALLBACK_URL, FRONTEND_REDIRECT_URL, PORT
#       not read by any code
#   NODE_ENV=development, PORT=5000
#       the backend defaults to 5001
#
# Use backend/.env.example instead. See docs/v2-production-setup.md.

NODE_ENV=development
PORT=5001

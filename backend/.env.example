# Copy to .env and fill in. .env is gitignored.

# --- Server ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- Database ---
# Phase 0 uses a brand new database alongside the current one.
# Default local: postgres://postgres:postgres@localhost:5432/unmute_v2
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unmute_v2

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Admin seed (optional) ---
# If both are set, `npm run seed` upserts an admin user with these credentials.
# Leave empty in production and create admins via SQL instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Google OAuth (phase 1; can stay empty until then) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Email (Gmail over SMTP) ---
# Gmail is the only transport. SendGrid retired its free tier; Resend's free
# tier can only send from onboarding@resend.dev, which delivers exclusively to
# the Resend account owner's inbox. Neither can send from a real Gmail address.
# See src/services/emailService.js.
#
#   smtp  (default) — nodemailer against smtp.gmail.com
#   stub            — prints to the log and delivers NOTHING (local dev only)
#
# With the default provider the server REFUSES TO BOOT unless SMTP_USER and
# SMTP_PASS are set. That is deliberate: a mailer that boots healthy but
# silently drops every message is worse than one that fails loudly.
#
# To get SMTP_PASS: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords. Use that 16-character code with
# spaces removed — Google rejects the real Gmail account password.
#
# ⚠️ Render blocks outbound SMTP (25/465/587) on FREE web services. A free
# instance will hang on connect and every send will fail.
EMAIL_PROVIDER=smtp

# SMTP_USER and SMTP_PASS must be the SAME account. An app password is tied to
# one Google account, and Gmail only sends as the account you authenticate with,
# so a mismatched pair delivers from the wrong address. Set BOTH of these to
# the sender you want, or leave both empty to use the GMAIL_* aliases below.
SMTP_USER=
SMTP_PASS=

# Google's own names for the same two values. Used only when the SMTP_* pair
# above is empty; do not set all four, or SMTP_* wins and the GMAIL_* values
# are silently ignored.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional — derived from SMTP_USER when omitted:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=            # defaults to SMTP_USER
EMAIL_FROM_NAME=unmute

# --- Frontend origin (CORS) ---
FRONTEND_URL=http://localhost:5173

# Public origin of THIS backend, used in docs and the V1 webhook callback.
# V2 webhooks are registered in the PhonePe dashboard, but both must point to:
#   ${API_PUBLIC_URL}/api/webhooks/phonepe
# On Render this defaults to RENDER_EXTERNAL_URL when left empty.
API_PUBLIC_URL=

# --- PhonePe (payments) ------------------------------------------------------
# V2 is the current API and wins whenever all three client credentials are set.
# Get them from business.phonepe.com -> Developer Settings -> API Keys.
#   sandbox:    Test Mode ON
#   production: Test Mode OFF
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=

# Hosts are derived from PHONEPE_ENV; override only if PhonePe changes them.
# PHONEPE_AUTH_HOST=https://api-preprod.phonepe.com/apis/pg-sandbox
# PHONEPE_API_HOST=https://api-preprod.phonepe.com/apis/pg-sandbox
# Production:
# PHONEPE_AUTH_HOST=https://api.phonepe.com/apis/identity-manager
# PHONEPE_API_HOST=https://api.phonepe.com/apis/pg

# Webhook auth: match the method selected when creating the webhook in the
# PhonePe dashboard. sha = SHA256(username:password) in Authorization.
# hmac = HMAC-SHA256(raw body) in phonepe-checksum-signature.
PHONEPE_WEBHOOK_AUTH=sha
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Only for PHONEPE_WEBHOOK_AUTH=hmac:
PHONEPE_WEBHOOK_SECRET=

# Local fake payments only. Never enable outside local dev; production must
# fail loudly instead of pretending a top-up succeeded.
PHONEPE_ALLOW_STUB=false

# --- PhonePe V1 (legacy, only if your account still uses salt keys) ----------
# V2 takes precedence when the client credentials above are set.
# PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
# PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
# PHONEPE_SALT_INDEX=1
# PHONEPE_HOST=https://api-preprod.phonepe.com/apis/pg-sandbox

# --- Payment gateway switch -------------------------------------------------
# ONE variable flips wallet top-ups between the two fully-implemented gateways.
#   phonepe  -> the PhonePe flow above (default)
#   razorpay -> Razorpay Standard Checkout below
PAYMENT_GATEWAY=phonepe

# --- Razorpay (Standard Checkout) -------------------------------------------
# Get these from https://dashboard.razorpay.com/app/keys. KEY_SECRET is used to
# sign the create-order API call and to verify the checkout signature; it is
# server-side only and must NEVER be sent to the frontend.
# The frontend only needs the public KEY_ID (VITE_RAZORPAY_KEY_ID).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Agora ---
# Get from https://console.agora.io → your project → "App Certificate"
# Without these, the meeting room runs in stub mode (no real video).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Firebase Push Notifications (Admin SDK) ---
# Paste either the JSON string or the path to serviceAccountKey.json
# Generate from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=
